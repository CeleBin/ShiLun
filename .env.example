# Public recommendations need no auth credentials.
# Accounts, wheel sync, favorites, submissions and feedback use the server-side Upstash store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Server-side user IDs granted moderation permissions.
SHILUN_ADMIN_USER_IDS=
# Optional server-side Amap Web Service key for nearby dining.
AMAP_WEB_SERVICE_KEY=
